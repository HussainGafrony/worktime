# Local MongoDB (recommended for fully local development)
MONGODB_URI=mongodb://127.0.0.1:27017/worktimecluster
MONGODB_URI=mongodb://user:pass@ac-rhj3kaw-shard-00-00.vil8qv8.mongodb.net:27017,ac-rhj3kaw-shard-00-01.vil8qv8.mongodb.net:27017,ac-rhj3kaw-shard-00-02.vil8qv8.mongodb.net:27017/worktime?tls=true&authSource=admin&replicaSet=atlas-r4oeim-shard-0&retryWrites=true&w=majority&appName=Cluster0


# Or use MongoDB Atlas instead:
