# Development-only secret used to look up worker PINs.
# Keep your production value different and private.
PIN_LOOKUP_SECRET=local-dev-pin-lookup-secret-change-me-123456

APP_TIMEZONE=Europe/Athens
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# API dev server port. Vite proxies /api to this port.
API_PORT=3001

# Set true if you want the demo-data button in local development.
VITE_ENABLE_SEED_DATA=false
