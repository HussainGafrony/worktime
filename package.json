{
  "name": "worktime-react-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch --import tsx api/dev.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "exceljs": "4.4.0",
    "express": "5.1.0",
    "mongoose": "8.24.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "@types/jsonwebtoken": "9.0.10",
    "concurrently": "9.2.1",
    "tsx": "4.20.6"
  },
  "engines": {
    "node": ">=22"
  }
}
